      "push"
    ],
    "translation_ids": [
      "zh-push"
    ],
    "source": "The maximum disturbance applied to Valkyrie is 520 N for 0.1 s.",
    "translation": [
      "Valkyrie 承受的最大推力为 520 N，持续 0.1 秒。"
    ],
    "notes": ""
  },
