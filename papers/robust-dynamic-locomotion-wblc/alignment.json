[
  {
    "id": "abstract-01",
    "section": "摘要",
    "type": "paragraph",
    "source_ids": [
      "abstract-01"
    ],
    "translation_ids": [
      "zh-abstract-01"
    ],
    "source": "We propose a robust dynamic walking controller consisting of a dynamic locomotion planner, reinforcement learning, and a whole-body locomotion controller.",
    "translation": [
      "本文提出鲁棒动态行走控制器，由步行规划器、强化学习和全身步行控制器组成。"
    ],
    "notes": ""
  },
  {
    "id": "eq-03",
    "section": "强化学习",
    "type": "equation",
    "source_ids": [
      "eq-03"
    ],
    "translation_ids": [
      "zh-eq-03"
    ],
    "source": "$$R=-(\\dot x^{nom}_{apex}-\\dot x_{apex})^2-15(p_y^{nom}-p_y)^2-(\\dot y_{apex})^2. \\tag{3}$$",
    "translation": [
      "$$R=-(\\dot x^{nom}_{apex}-\\dot x_{apex})^2-15(p_y^{nom}-p_y)^2-(\\dot y_{apex})^2. \\tag{3}$$"
    ],
    "notes": ""
  },
  {
    "id": "eq-06",
    "section": "WBLC",
    "type": "equation",
    "source_ids": [
      "eq-06"
    ],
    "translation_ids": [
      "zh-eq-06"
    ],
    "source": "$$\\ddot q_1=J_1^\\#(\\ddot x_{d,1}-\\dot J_1\\dot q). \\tag{6}$$",
    "translation": [
      "$$\\ddot q_1=J_1^\\#(\\ddot x_{d,1}-\\dot J_1\\dot q). \\tag{6}$$"
    ],
    "notes": ""
  },
  {
    "id": "eq-11",
    "section": "WBLC",
    "type": "equation",
    "source_ids": [
      "eq-11"
    ],
    "translation_ids": [
      "zh-eq-11"
    ],
    "source": "$$A(q)\\ddot q_d+b(q,\\dot q)+g(q)+J_r^TF_r=U^T\\tau. \\tag{11}$$",
    "translation": [
      "$$A(q)\\ddot q_d+b(q,\\dot q)+g(q)+J_r^TF_r=U^T\\tau. \\tag{11}$$"
    ],
    "notes": ""
  },
  {
    "id": "eq-31",
    "section": "质心动量",
    "type": "equation",
    "source_ids": [
      "eq-31"
    ],
    "translation_ids": [
      "zh-eq-31"
    ],
    "source": "$$\\dot J_{cm}\\dot q=J_{cm}A^{-1}b. \\tag{31}$$",
    "translation": [
      "$$\\dot J_{cm}\\dot q=J_{cm}A^{-1}b. \\tag{31}$$"
    ],
    "notes": ""
  },
  {
