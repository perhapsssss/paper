  {
    "id": "conclusion",
    "section": "结论",
    "type": "paragraph",
    "source_ids": [
      "conclusion"
    ],
    "translation_ids": [
      "zh-conclusion"
    ],
    "source": "The planner computes a multi-step walking trajectory almost instantaneously and WBLC respects contact and friction constraints.",
    "translation": [
      "步行规划器几乎即时生成多步轨迹，WBLC 同时满足接触与摩擦约束。"
    ],
